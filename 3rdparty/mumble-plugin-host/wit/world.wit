// Component-model interface shared by the plugin host (`mumble-plugin-host`)
// and WASM plugin guests (`mumble-plugin-api-wasm`).
//
// The host loads a `.wasm` component implementing `plugin-world` and drives it
// exactly like a native cdylib plugin: the guest *exports* the `guest`
// interface (the lifecycle/event hooks mirroring the native `MumblePlugin`
// trait) and *imports* the `host` interface (the callbacks mirroring the native
// `PluginContext` trait).
//
// There is no per-call `ctx` argument: the imported `host` functions ARE the
// context. The host installs the active `PluginContext` for the duration of
// each exported call, so a guest simply calls the host imports directly.
//
// Sandbox: this world imports ONLY the `host` interface below. No WASI, no
// filesystem, no sockets, no clock, no randomness are linked. A guest can only
// affect the world through these explicit calls.
package mumble:plugin@0.1.0;

interface types {
    /// One write in a KV batch. A missing value is a delete.
    record kv-op {
        key: list<u8>,
        value: option<list<u8>>,
    }

    /// One key/value pair a scan returned.
    record kv-pair {
        key: list<u8>,
        value: list<u8>,
    }

    /// A writable slot for one object, and where to send the bytes.
    record object-slot {
        key: string,
        url: string,
        method: string,
        expires-at-ms: u64,
    }

    /// One revision of a name.
    record name-rev {
        found: bool,
        rev: u64,
        key: string,
        created-at-ms: u64,
    }

    /// One name at the revision it currently answers with.
    record named-object {
        name: string,
        latest: name-rev,
    }

    /// Virtual server id within a single murmur process.
    type server-id = u32;
    /// Connected client session id within a virtual server.
    type session-id = u32;
    /// Channel id within a virtual server.
    type channel-id = u32;

    /// Snapshot of a newly connected client (mirrors native `ClientInfo`).
    record client-info {
        server-id: server-id,
        session-id: session-id,
        username: string,
        cert-hash: string,
    }

    /// Inbound generic plugin message addressed to this plugin
    /// (mirrors native `PluginMessageIn`).
    record plugin-message-in {
        server-id: server-id,
        sender-session: session-id,
        sender-name: string,
        plugin-name: string,
        payload-type: string,
        payload: list<u8>,
        channel-id: option<channel-id>,
    }

    /// Outbound generic plugin message produced by the guest
    /// (mirrors native `PluginMessageOut`).
    record plugin-message-out {
        server-id: server-id,
        plugin-name: string,
        payload-type: string,
        payload: list<u8>,
        target-sessions: list<u32>,
        channel-id: option<channel-id>,
    }

    /// Error returned from guest hooks and host calls
    /// (mirrors native `PluginError`).
    variant plugin-error {
        config(string),
        io(string),
        context-disposed,
        other(string),
    }
}

/// Callbacks the guest may invoke (mirrors the native `PluginContext` trait).
/// Implemented by the host; only valid while a `plugin` export call is running.
interface host {
    use types.{server-id, session-id, channel-id, plugin-message-out, plugin-error};
    use types.{kv-op, kv-pair, object-slot, name-rev, named-object};

    /// Send a `PluginDataTransmission` to a single connected session.
    send-plugin-data: func(
        server-id: server-id,
        target-session: session-id,
        data-id: string,
        data: list<u8>,
    ) -> result<_, plugin-error>;

    /// Whether the session is currently connected.
    is-session-active: func(server-id: server-id, session: session-id) -> bool;

    /// Whether the session may enter the channel per server ACLs.
    user-has-channel-access: func(
        server-id: server-id,
        session: session-id,
        channel: channel-id,
    ) -> bool;

    /// Whether the session holds every permission in `permission-flags`.
    has-permission: func(
        server-id: server-id,
        session: session-id,
        channel: channel-id,
        permission-flags: u32,
    ) -> bool;

    /// Channel the session is currently in, if known.
    current-channel: func(server-id: server-id, session: session-id) -> option<channel-id>;

    /// Look up a configuration value scoped to the calling plugin.
    get-config: func(key: string) -> option<string>;

    /// Dispatch a generic plugin message envelope (wire id 200).
    send-plugin-message: func(msg: plugin-message-out) -> result<_, plugin-error>;

    /// Session ids of every user currently in `channel`.
    sessions-in-channel: func(server-id: server-id, channel: channel-id) -> list<u32>;

    /// Session ids of every connected user on `server-id`.
    all-sessions: func(server-id: server-id) -> list<u32>;

    /// Resolve a username (exact match) to its current session id.
    find-session-by-name: func(server-id: server-id, name: string) -> option<session-id>;

    // -- storage -----------------------------------------------------------
    //
    // Until these existed a WASM plugin could not persist a single byte: the
    // sandbox has no filesystem, no network and no environment, and the host
    // offered nothing in their place. The namespace is implicit - the host
    // knows which plugin is calling - so a key here cannot name another's.

    /// Read one key from this plugin's own storage.
    kv-get: func(server-id: server-id, key: list<u8>) -> option<list<u8>>;

    /// Every pair in `[start, end)`, in key order, at most `limit` of them.
    /// `reverse` walks the range backwards.
    kv-scan: func(
        server-id: server-id,
        start: list<u8>,
        end: list<u8>,
        limit: u32,
        reverse: bool,
    ) -> list<kv-pair>;

    /// Apply a batch of writes atomically: all of them, or none. The batch is
    /// what makes a secondary index safe to keep.
    kv-write: func(server-id: server-id, ops: list<kv-op>) -> result<_, plugin-error>;

    /// Open a writable slot for one object in this plugin's namespace. The
    /// bytes do not cross this boundary: `PUT` them to the returned URL.
    object-reserve: func(
        server-id: server-id,
        filename: string,
        content-type: string,
        size: u64,
        public: bool,
    ) -> option<object-slot>;

    /// A short-lived signed URL to read one of this plugin's objects back.
    object-url: func(server-id: server-id, key: string) -> option<string>;

    /// Point a name at an object, as a new revision. `keep` bounds the history
    /// afterwards; `0` keeps every revision.
    name-put: func(
        server-id: server-id,
        name: string,
        key: string,
        keep: u64,
    ) -> result<u64, plugin-error>;

    /// What a name currently answers with.
    name-latest: func(server-id: server-id, name: string) -> option<name-rev>;

    /// A name's revisions, newest first.
    name-revisions: func(server-id: server-id, name: string, limit: u32) -> list<name-rev>;

    /// Every name this plugin has stored, each at its latest revision.
    name-list: func(server-id: server-id) -> list<named-object>;

    /// Forget a name and every revision of it.
    name-forget: func(server-id: server-id, name: string) -> result<_, plugin-error>;
}

/// Hooks the guest implements (mirrors the native `MumblePlugin` trait).
interface guest {
    use types.{server-id, session-id, client-info, plugin-message-in, plugin-error};

    /// Plugin-api ABI version the guest was built against. The host rejects
    /// the component unless this equals its own `PLUGIN_ABI_VERSION`.
    abi-version: func() -> u32;

    /// Stable plugin identifier.
    name: func() -> string;

    /// SemVer of the plugin release.
    version: func() -> string;

    /// JSON-encoded `PluginInfo`. Defaults to `"{}"` when not overridden.
    info-json: func() -> string;

    /// Called once when the plugin is loaded.
    on-load: func() -> result<_, plugin-error>;

    /// Called once when the plugin is unloaded.
    on-unload: func() -> result<_, plugin-error>;

    /// Fires when a client authenticates and joins the server.
    on-client-connected: func(info: client-info) -> result<_, plugin-error>;

    /// Fires when a client disconnects.
    on-client-disconnected: func(
        server-id: server-id,
        session: session-id,
    ) -> result<_, plugin-error>;

    /// Fires for every `PluginDataTransmission` the server receives.
    on-plugin-data: func(
        server-id: server-id,
        sender: session-id,
        data-id: string,
        data: list<u8>,
    ) -> result<_, plugin-error>;

    /// Receives a generic plugin message envelope addressed to this plugin.
    on-plugin-message: func(msg: plugin-message-in) -> result<_, plugin-error>;
}

/// The world a WASM plugin must implement to be loadable by the host.
///
/// `host` / `guest` are the low-level generic channel (raw `PluginMessage`
/// bytes).  `ui-host` / `ui-guest` (see `ui.wit`) layer the typed, JSON-free
/// Tier-1 UI protocol (slash commands, components, modals, toasts) on top, so
/// guests can drive client UI without ever building or parsing wire JSON.
world plugin-world {
    import host;
    import ui-host;
    export guest;
    export ui-guest;
}
